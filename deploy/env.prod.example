# Шаблон /opt/education-platform/.env на srv (права 600, власник edu-deploy) —
# інфраструктура: compose, Mongo, бекап. Секрети застосунку — окремо в app.env
# (deploy/app.env.example).
# Секрети генеруються на сервері: openssl rand -hex 32
# Паролі Mongo — лише hex: вони підставляються в URI без екранування.

# Тег образу — оновлює GitHub Actions при кожному деплої.
IMAGE_TAG=latest
APP_PORT=3300

# --- MongoDB (контейнер mongo у цьому ж compose) ---
MONGO_DB=education_platform
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=portal
MONGO_APP_PASSWORD=

# --- Бекап Mongo → DigitalOcean Spaces (deploy/backup-mongo.sh) ---
BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
BACKUP_S3_BUCKET=education-platform
BACKUP_S3_PREFIX=mongo/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Скільки останніх бекапів тримати в S3 та локально (ротація за кількістю).
BACKUP_S3_KEEP=30
BACKUP_LOCAL_KEEP=3
# Сповіщення в Telegram (необовʼязково: порожньо — не надсилати).
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
