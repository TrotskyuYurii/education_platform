# Шаблон /opt/education-platform/app.env — змінні застосунку (права 600).
# Лише цей файл потрапляє в контейнер app. MONGODB_URI, NODE_ENV, PORT і
# TRUST_PROXY задає docker-compose.prod.yml.

# openssl rand -hex 48
JWT_SECRET=
ANTHROPIC_API_KEY=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_IDLE_WARNING_SECONDS=60

# --- Пошта: Power Automate (основний шлях; SMTP AUTH у тенанті M365 вимкнено) ---
# URL flow містять підпис доступу (sig=...) — це секрети. Порожньо — SMTP нижче.
# Коди входу: POST { email, passcode, service }
OTP_POWER_AUTOMATE_URL=
OTP_POWER_AUTOMATE_SERVICE=ep.viasecurity.tech
# Сповіщення: POST { email, subject, body(HTML) } на кожного отримувача
NOTIFICATION_POWER_AUTOMATE_URL=

# --- Пошта: SMTP (запасний варіант) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM='"ВІАТЕК Безпека" <no-reply@viatec.ua>'
SMTP_SECURE=false

