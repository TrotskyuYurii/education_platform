MONGODB_URI=
# Обов'язково у продакшені: довгий випадковий рядок (мін. 32 символи),
# напр. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
ANTHROPIC_API_KEY=

# SMTP налаштування для відправки email кодів авторизації (опціонально)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ВІАТЕК Безпека" <no-reply@viatec.ua>
SMTP_SECURE=false

# Таймаут бездіяльності сесії (хвилини) — після стількох хвилин без дій
# користувача застосунок автоматично виходить. За замовчуванням 30.
SESSION_IDLE_TIMEOUT_MINUTES=30
# За скільки секунд до виходу показати попередження з таймером. За замовчуванням 60.
SESSION_IDLE_WARNING_SECONDS=60

# Бекенд за реверс-проксі (nginx/IIS): кількість проксі попереду (зазвичай 1).
# Потрібно, щоб ліміти входу бачили реальний IP, а cookie — протокол https.
TRUST_PROXY=
# Примусовий прапорець Secure для cookie сесії (true|false). Порожньо — за
# протоколом запиту: https → Secure, http (внутрішня мережа без TLS) → без Secure.
COOKIE_SECURE=
