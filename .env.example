# Таймаут бездіяльності сесії (хвилини) — після стількох хвилин без дій
# користувача застосунок автоматично виходить. За замовчуванням 30.
SESSION_IDLE_TIMEOUT_MINUTES=30
# За скільки секунд до виходу показати попередження з таймером. За замовчуванням 60.
SESSION_IDLE_WARNING_SECONDS=60
